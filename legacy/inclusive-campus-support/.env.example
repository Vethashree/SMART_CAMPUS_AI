# Copy to .env.local for local development.
# Leave VITE_API_BASE_URL unset to run entirely against the local, in-browser
# ticket repository (no AWS deployment required) — see src/repositories/index.ts.

# Base URL of the deployed API Gateway stage, e.g. https://abc123.execute-api.ap-south-1.amazonaws.com/prod
VITE_API_BASE_URL=

# Cognito (only needed once real authentication is wired up)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
VITE_COGNITO_REGION=
