# Copy to .env.local for local development. Nothing here is required to run
# Smart Campus Core (dashboard, attendance, timetable, CGPA, etc.) or the
# deterministic SERA concierge engine (recommendations, scheduling, study
# allocation) — those work with zero configuration. These variables are only
# needed for Persona Health (auth, wellness assessment persistence, institute
# dashboard) and the SERA wellness chatbot.

# --- Supabase (Persona Health backend) ---
# From your Supabase project settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- OAuth (optional, for Persona Health's GitHub/Google sign-in) ---
# Configure these as OAuth providers in the Supabase dashboard, not here —
# these values just record which providers are enabled for local reference.
VITE_GITHUB_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Admin bootstrap (Persona Health institute dashboard) ---
# Used once by /persona/admin-setup to create the first institute admin
# account. Do not commit real values; rotate the password after first login.
VITE_SERA_ADMIN_BOOTSTRAP_EMAIL=
VITE_SERA_ADMIN_BOOTSTRAP_PASSWORD=

# --- Supabase Edge Function secret (server-side only, never a VITE_ var) ---
# Set via `supabase secrets set LOVABLE_API_KEY=...`, not in this file, and
# never in frontend code. Required for supabase/functions/sera-chat to reach
# the AI gateway; the wellness chatbot degrades to a "not connected" notice
# without it, and everything else in the app is unaffected.
# LOVABLE_API_KEY=
